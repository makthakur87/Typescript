{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "paths": {
      "@pages/*": ["pages/*"],
      "@config/*": ["config/*"], 
      "@fixtures/*": ["fixtures/*"],
      "@reusablefunctions/*": ["reusable_functions/*"],
      "@utils/*": ["config/utils/*"],
      "@testdata/*": ["testdata/*"],
      "@tests/*": ["tests/*"]
    },
    "types": ["node", "@playwright/test"]
  },
  "include": ["src/**/*", "playwright.config.ts", "src/TypeScriptCode"],
  "exclude": ["node_modules", "dist", "reports"]
}
